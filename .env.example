# Copie ce fichier en .env avant `docker compose up -d`.

# Clé de chiffrement des secrets stockés en base. Obligatoire.
#   openssl rand -hex 32
APP_SECRET=

# URL publique de l'instance (sans slash final). Sert au retour de GitHub
# lors de la création en un clic de la GitHub App.
PUBLIC_URL=http://localhost:3000

# Port exposé sur l'hôte.
PORT=3000

# true si tu sers l'app en HTTPS derrière un reverse proxy.
COOKIE_SECURE=false
